ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-sonnet-5-5

# Host folder containing .txt / .md files to index (default: ~/Documents/RAGapp)
# DOCS_DIR_HOST=/Users/you/Documents/RAGapp

# Guardrails (LLM judges use GUARD_MODEL; set GUARDRAILS_ENABLED=false to bypass)
# GUARDRAILS_ENABLED=true
# GUARD_MODEL=claude-haiku-5-5
# ALLOWED_TOPICS=questions about the contents of the indexed documents
